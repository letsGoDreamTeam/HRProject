## AI 사용 여부
USE_AI=true

## 사용할 공급자: openai | anthropic | gemini | all
AI_PROVIDER=gemini

## AI 전송 전 민감정보 익명화 (권장 true)
AI_ANONYMIZE=true

## Gemini 설정
## - Google AI Studio 에서 발급한 API 키
## - 키 이름 예시: AIza...
GEMINI_API_KEY=your_gemini_api_key_here

## Gemini 모델명
## - 권장: gemini-1.5-pro
## - 대안: gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-pro

## (선택) OpenAI 설정
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4.1-mini

## (선택) Anthropic 설정
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
