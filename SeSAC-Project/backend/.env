# 이전 버전 JSONB 단일 컬럼만 쓰던 DB는 interview_* 테이블 정리 후 재기동해 테이블을 다시 만드세요.
# 쉼표로 구분. 로컬 프론트 기본: 5173
DATABASE_URL=postgresql://postgres.cixpmtwtzjpmkkawquem:kwnam0715!!@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
