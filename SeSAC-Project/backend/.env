# 구조화 출력 일관성 (강의 structured-output 권장)
OPENAI_TEMPERATURE=0
# Router+가드레일: true면 채용 공고 여부를 게이트 모델로 1회 분류
JD_INPUT_GATE_ENABLED=false
OPENAI_GATE_MODEL=gpt-4o
# Reflection: evidence가 JD 부분 문자열이 아니면 1회 교정 호출
JD_EVIDENCE_REPAIR_ENABLED=true

# 스캔 PDF: pypdf 텍스트가 짧으면 PyMuPDF→OpenAI Vision OCR (페이지당 API 1회)
PDF_OCR_ENABLED=true
PDF_OCR_MODEL=gpt-4o

# JD 역량(items) 최대 개수 (1~250, OpenAI 출력 한도)
JD_MAX_COMPETENCIES=250

# 쉼표로 구분. 로컬 프론트 기본: 5173
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# A-PASS: 인재상 RAG 임베딩 모델·벡터 JSON 저장 디렉터리(백엔드 기준 상대경로)
APASS_EMBEDDING_MODEL=text-embedding-3-small
APASS_DATA_DIR=.apass_data

