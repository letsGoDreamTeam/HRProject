OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# 구조화 출력 일관성 (강의 structured-output 권장)
OPENAI_TEMPERATURE=0
# Router+가드레일: true면 채용 공고 여부를 게이트 모델로 1회 분류
JD_INPUT_GATE_ENABLED=false
OPENAI_GATE_MODEL=gpt-4o-mini
# Reflection: evidence가 JD 부분 문자열이 아니면 1회 교정 호출
JD_EVIDENCE_REPAIR_ENABLED=true

# PDF 업로드 최대 크기(바이트). 기본 100MB. 상한 250MB(.env에서 조정)
PDF_MAX_BYTES=104857600

# 스캔 PDF: pypdf 텍스트가 짧으면 PyMuPDF→OpenAI Vision OCR (페이지당 API 1회, 병렬)
PDF_OCR_ENABLED=true
PDF_OCR_MODEL=gpt-4o-mini
PDF_OCR_MIN_CHARS=80
# 0 = 전 페이지 OCR. 양수면 해당 페이지 수까지만.
PDF_OCR_MAX_PAGES=0
PDF_OCR_ZOOM=2
PDF_OCR_MAX_EDGE_PX=2048
# OCR API 병렬 수 (1~16)
PDF_OCR_CONCURRENCY=6
# 이력서 텍스트 품질 기준(추출 글자 수 최소)
RESUME_TEXT_MIN_CHARS=120

# 통합 직무소개서: 텍스트 청크·청크별 LLM 병렬 워커 (LangGraph extract 단계)
HR_JOB_PDF_CHUNK_SIZE=8000
HR_JOB_PDF_CHUNK_OVERLAP=400
HR_JOB_PDF_EXTRACT_WORKERS=8

# 회사 프로필 PDF 4분할 시 LLM 입력 최대 글자
COMPANY_PROFILE_SPLIT_MAX_CHARS=500000

# JD 역량(items) 최대 개수 (1~250, OpenAI 출력 한도)
JD_MAX_COMPETENCIES=100

# Supabase: Project Settings → Database → Connection string
# 스키마: interview_analyses → interview_competencies → interview_questions (FK + CASCADE)
DATABASE_URL=postgresql+psycopg://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 쉼표로 구분. 로컬 프론트 기본: 5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 지원자 면접 시간 선택 링크(이메일/SMS)에 넣는 프론트 공개 URL. 비우면 CORS_ORIGINS 첫 항목 사용.
FRONTEND_PUBLIC_URL=

# A-PASS: 인재상 RAG 임베딩 모델·벡터 JSON 저장 디렉터리(백엔드 기준 상대경로)
APASS_EMBEDDING_MODEL=text-embedding-3-small
APASS_DATA_DIR=.apass_data
